# Copier ce fichier vers .env puis adapter les valeurs.
# Ne jamais committer le fichier .env.

# ----- PostgreSQL -----
POSTGRES_DB=stockmanager
POSTGRES_USER=stockmanager
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ----- Backend -----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
DB_URL=jdbc:postgresql://postgres:5432/stockmanager
DB_USERNAME=stockmanager
DB_PASSWORD=change-me-strong-password

# Secret JWT : minimum 32 caractères, idéalement généré (openssl rand -base64 48)
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=480

# Compte administrateur initial (créé au premier démarrage si absent)
ADMIN_EMAIL=admin@stockmanager.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Données de démonstration (true en local uniquement)
SEED_DEMO_DATA=true

# Stockage des documents : local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage/documents

# ----- AWS S3 (si STORAGE_TYPE=s3) -----
AWS_REGION=eu-west-3
S3_BUCKET_DOCUMENTS=stockmanager-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- Frontend -----
# Le frontend est servi par nginx et proxyfie /api vers le backend.
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
